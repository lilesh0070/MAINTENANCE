# ─────────────────────────────────────────────────────────────
# Line-ending normalization — so the SAME repo works on Windows
# AND Linux (Ubuntu) without churn or broken scripts.
#
# Everything is stored as LF in git. On checkout it stays LF on
# Linux/macOS; Windows tooling (Python, Node, VS Code) handles LF
# fine, so we keep LF there too — except .bat which Windows needs
# as CRLF, and .sh which Linux needs as LF.
# ─────────────────────────────────────────────────────────────
* text=auto eol=lf

# Windows batch files MUST stay CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Shell scripts MUST be LF — a CRLF .sh fails on Linux with
# "bad interpreter: /bin/bash^M"
*.sh   text eol=lf

# Binary assets — never touch their bytes / line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.xlsx binary
*.xls  binary
*.woff  binary
*.woff2 binary
