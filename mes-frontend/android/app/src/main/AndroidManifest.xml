<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- TV ON HOTE HI APP KHUD KHUL JAYE  the reliable way.

                 `BootReceiver` bhi laga hai, par Android 10+ me "background
                 se activity kholna" par rok hai  emulator (Android 15) par
                 naap kar dekha: boot ke baad app NAHI khulti.  Bahut se TV
                 box use chalne dete hain, par uspar bharosa nahi kiya ja
                 sakta.

                 Jo PAKKA chalta hai wo ye hai: app ko TV ka HOME bana do.
                 Android boot hote hi HOME app kholta hai, aur wo rok kisi
                 par lagti hi nahi  kyunki wo background se shuru nahi
                 hoti, system khud kholta hai.

                 Ye filter app ko sirf CHUNNE LAYAK banata hai, khud kuch
                 nahi badalta.  TV par ek baar Settings me "Home app" me
                 Maintenance chun lein  uske baad har boot par TV seedha
                 isi me khulegi.  PHONE PAR ASAR NAHI: wahan koi ise Home
                 chunega hi nahi. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>

        <!-- TV/device on hote hi app khud khul jaye (BootReceiver.java).
             `directBootAware` isliye ki PIN lagne se PEHLE wala broadcast
             bhi mil jaye — deewar par lagi TV par koi PIN dalne nahi
             jaata. -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Walkie-Talkie ka sunne wala hissa.  `mediaPlayback` type isliye
             ki Android 14+ par foreground service ko apna kism batana zaroori
             hai, aur ye service sirf aane wali aawaz BAJATI hai (record page
             karta hai, service nahi).  `exported=false` — ise sirf apni hi app
             chalu karti hai. -->
        <service
            android:name=".WalkieService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ANDON call aane par phone thartharata hai (AndonAlert.jsx).  Ye
         "normal" permission hai, install ke waqt hi mil jaati hai aur user se
         kuch poochha nahi jaata.  Bina iske navigator.vibrate() chupchaap
         kuch nahi karta, koi error bhi nahi deta. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- App ke andar se hi nayi APK install karne ke liye (ApkUpdate.java).
         Android 8+ par iske BINA installer khulta hi nahi, aur koi error bhi
         nahi aata - bas kuch nahi hota.  Ye permission maangne bhar se kuch
         install nahi hota; user ko phir bhi Android ki apni "Update / Install"
         wali screen par haan karni padti hai. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Boot ke baad app khud kholne ke liye (BootReceiver).  Ye "normal"
         permission hai — install ke waqt hi mil jaati hai, user se kuch
         poochha nahi jaata. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ══ WALKIE-TALKIE ══════════════════════════════════════════════
         RECORD_AUDIO + MODIFY_AUDIO_SETTINGS: page `getUserMedia()` bulata
         hai aur Capacitor ka apna BridgeWebChromeClient in DONO ko runtime
         par maang leta hai (dekh kar likha — capacitor-android ka
         onPermissionRequest).  Yaani yahan likhna hi kaafi hai, alag se
         permission-code likhne ki zaroorat nahi.

         FOREGROUND_SERVICE (+ _MEDIA_PLAYBACK, Android 14 se alag se maanga
         jaata hai): jeb me pade phone par call sunne ke liye.  WebView
         background me ROK diya jaata hai — isi app me naapa ja chuka hai —
         isliye socket Java ki service pakadti hai.

         POST_NOTIFICATIONS: Android 13+ par foreground service ki notification
         bhi isi ke bina nahi dikhti (service phir bhi chalti hai, par user ko
         pata hi nahi chalta ki walkie sun raha hai — wo theek nahi).  -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Settings me "Allow this app to run in the background" wala button
         Android ka apna parda kholta hai
         (ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS).  Android ke document ke
         mutabik us parde ke liye ye permission chahiye.  Ye SIRF parda kholne
         ki ijazat hai — chhoot khud user ko wahan "Allow" dabakar deni padti
         hai, koi code use nahi de sakta.
         (Play Store ise seemit karta hai; ye app sideload hoti hai.) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
</manifest>
