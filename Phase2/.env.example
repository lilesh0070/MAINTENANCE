# ─────────────────────────────────────────────────────────────
# Is file ki nakal `.env` bana kar asli values bhar dein:
#     cp Phase2/.env.example Phase2/.env
#
# `.env` gitignored hai — asli password KABHI commit na karein.
# main.py ise `load_dotenv(override=True)` se padhta hai.
# ─────────────────────────────────────────────────────────────

# ─── Database (PostgreSQL) — ZAROORI ─────────────────────────
DB_HOST=192.168.30.15
DB_PORT=5432
DB_NAME=maintenance_db
DB_USER=postgres
DB_PASS=
DB_CONNECT_TIMEOUT=5

# ─── Login token ka secret — ZAROORI ─────────────────────────
# Na dene par har restart pe nayi random key banti hai, yani sabke
# session log-out ho jaate hain.  Ek lamba random string daalein:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# ─── SMTP — PM reminder mail ke liye (na dein to mail band) ──
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── AI Assistant (na dein to AI chat band, baaki sab chalta) ─
ANTHROPIC_API_KEY=
AI_MODEL=
