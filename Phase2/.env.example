# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored — NEVER commit real secrets.
# Loaded by main.py via load_dotenv(override=True).
# ─────────────────────────────────────────────────────────────

# ─── Database (PostgreSQL) ───────────────────────────────────
DB_HOST=192.168.10.210
DB_PORT=5432
DB_NAME=energydb
DB_USER=postgres
DB_PASS=
DB_CONNECT_TIMEOUT=5

# ─── AI API keys ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# ─── SMTP (Office365) ────────────────────────────────────────
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
SLOT_REPORT_EMAIL=

# ─── CMS / video lookup ──────────────────────────────────────
CYCLE_VIDEO_BASE_URL=http://127.0.0.1:5555
CMS_BASE_URL=http://127.0.0.1:5555

# ─── NG -> Quality mail recipients (comma-separated) ─────────
QUALITY_NG_TO=
QUALITY_NG_CC=
