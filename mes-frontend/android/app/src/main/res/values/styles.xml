<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- App chalte waqt ka theme.  `android:background` yahan BEKAAR tha
         (wo view ka background hai, window ka nahi) aur `@null` hone ki wajah
         se window ka default SAFED rang aata tha — wahi jhalak app khulte hi
         dikhti thi.  Ab `android:windowBackground` par wahi gehra neela rang
         jo splash ke neeche ka hissa aur login page ka background hai. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/appBackground</item>
        <!--
          NOTCH / PUNCH-HOLE WALI JAGAH.

          Status bar to `ScreenMode` plugin chhupa deta hai, par jis phone me
          upar notch ya punch-hole hota hai, uski patti phir bhi KAALI reh
          jaati hai - kyunki Android default me app ko wahan tak failne hi
          nahi deta (`default` = cutout se bacho).

          `shortEdges` kehta hai: chhoti taraf ke cutout ke AAGE tak jao.
          Isse app poore upar tak fail jaati hai aur wo kaali patti khatam
          ho jaati hai.

          API 27 (Android 8.1) ka attribute hai; purane Android ise chup-chaap
          nazarandaz kar dete hain - wahan notch hota hi nahi, isliye koi
          nuksan nahi.
        -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- Launch theme.  Yahan bhi pehle `android:background` likha tha, isliye
         splash ka chitra window par lagta hi nahi tha — Android apna safed
         background dikha deta tha.  Ab teeno jagah sahi:
           windowBackground             -> purane Android ke liye
           windowSplashScreenBackground -> Android 12+ ke system splash ka rang
           postSplashScreenTheme        -> uske baad kaunsa theme lagega -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/splashBackground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
