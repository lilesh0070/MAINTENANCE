<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- TV ON HOTE HI APP KHUD KHUL JAYE  the reliable way.

                 `BootReceiver` bhi laga hai, par Android 10+ me "background
                 se activity kholna" par rok hai  emulator (Android 15) par
                 naap kar dekha: boot ke baad app NAHI khulti.  Bahut se TV
                 box use chalne dete hain, par uspar bharosa nahi kiya ja
                 sakta.

                 Jo PAKKA chalta hai wo ye hai: app ko TV ka HOME bana do.
                 Android boot hote hi HOME app kholta hai, aur wo rok kisi
                 par lagti hi nahi  kyunki wo background se shuru nahi
                 hoti, system khud kholta hai.

                 Ye filter app ko sirf CHUNNE LAYAK banata hai, khud kuch
                 nahi badalta.  TV par ek baar Settings me "Home app" me
                 Maintenance chun lein  uske baad har boot par TV seedha
                 isi me khulegi.  PHONE PAR ASAR NAHI: wahan koi ise Home
                 chunega hi nahi. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>

        <!-- TV/device on hote hi app khud khul jaye (BootReceiver.java).
             `directBootAware` isliye ki PIN lagne se PEHLE wala broadcast
             bhi mil jaye — deewar par lagi TV par koi PIN dalne nahi
             jaata. -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ANDON call aane par phone thartharata hai (AndonAlert.jsx).  Ye
         "normal" permission hai, install ke waqt hi mil jaati hai aur user se
         kuch poochha nahi jaata.  Bina iske navigator.vibrate() chupchaap
         kuch nahi karta, koi error bhi nahi deta. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- App ke andar se hi nayi APK install karne ke liye (ApkUpdate.java).
         Android 8+ par iske BINA installer khulta hi nahi, aur koi error bhi
         nahi aata - bas kuch nahi hota.  Ye permission maangne bhar se kuch
         install nahi hota; user ko phir bhi Android ki apni "Update / Install"
         wali screen par haan karni padti hai. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Boot ke baad app khud kholne ke liye (BootReceiver).  Ye "normal"
         permission hai — install ke waqt hi mil jaati hai, user se kuch
         poochha nahi jaata. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
